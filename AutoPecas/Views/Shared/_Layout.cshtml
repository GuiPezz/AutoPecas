@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - João Auto Peças</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Ícones Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

    <style>
        :root {
            --azul: #003366;
            --vermelho: #dc3545;
            --amarelo: #ffcc00;
            --cinza-claro: #f8f9fa;
        }

        body {
            background-color: var(--cinza-claro);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* 🔹 Navbar principal */
        .navbar-main {
            background-color: var(--azul);
            padding: 0.8rem 0;
        }

        .navbar-brand {
            color: white !important;
            font-weight: 700;
            letter-spacing: 0.5px;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
        }

            .navbar-brand span {
                color: var(--amarelo);
            }

        /* 🔹 Campo de busca */
        .search-box {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            margin-left: 20px;
        }

            .search-box input {
                border: 1px solid #ccc;
                border-radius: 4px;
                padding: 6px 10px;
                width: 280px;
            }

            .search-box button {
                border: none;
                border-radius: 4px;
                background-color: var(--amarelo);
                color: #000;
                font-weight: 600;
                padding: 6px 12px;
                transition: 0.2s;
            }

                .search-box button:hover {
                    background-color: #ffd633;
                }

        /* 🔹 Links */
        .nav-link {
            color: white !important;
            font-weight: 500;
            margin-right: 15px;
        }

            .nav-link:hover {
                color: var(--amarelo) !important;
            }

        /* 🔹 Carrinho */
        .cart-btn {
            position: relative;
            background-color: var(--vermelho);
            color: white;
            border: none;
            border-radius: 50%;
            padding: 10px;
            font-size: 1.3rem;
        }

            .cart-btn:hover {
                background-color: #bb2d3b;
            }

        .cart-badge {
            position: absolute;
            top: 0;
            right: 0;
            transform: translate(50%, -50%);
            background-color: white;
            color: var(--vermelho);
            border-radius: 50%;
            font-size: 0.7rem;
            font-weight: bold;
            padding: 2px 5px;
        }

        footer {
            background-color: var(--azul);
            color: white;
            padding: 10px;
            text-align: center;
            margin-top: 40px;
        }
    </style>
</head>
<body>

    <!-- 🔹 Navbar principal -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-main">
            <div class="container justify-content-between align-items-center">

                <!-- 🔸 Logo + Barra de busca -->
                <div class="d-flex align-items-center">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        João <span>Auto Peças</span>
                    </a>

                    <!-- Barra de busca -->
                    <form asp-controller="Produtos" asp-action="Index" method="get" class="search-box">
                        <input name="searchString" type="search" placeholder="Digite aqui o que procura..." />
                        <button type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>

                <!-- 🔸 Navegação e Carrinho -->
                <div class="d-flex align-items-center gap-4">
                    <ul class="navbar-nav d-flex flex-row gap-3 mb-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Produtos" asp-action="Index">Produtos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Categorias" asp-action="Index">Categorias</a></li>
                    </ul>

                    <!-- Carrinho com contador dinâmico -->
                    <li class="nav-item ms-2 list-unstyled">
                        @{
                            int carrinhoCount = Context.Session.GetInt32("CarrinhoCount") ?? 0;
                        }
                        <a asp-controller="Carrinho" asp-action="Index" class="btn cart-btn position-relative">
                            <i class="bi bi-cart"></i>
                            @if (carrinhoCount > 0)
                            {
                                <span class="cart-badge">@carrinhoCount</span>
                            }
                        </a>
                    </li>
                </div>
            </div>
        </nav>
    </header>

    <!-- 🔹 Conteúdo -->
    <main role="main" class="container mt-4">
        @RenderBody()
    </main>

    <!-- 🔹 Rodapé -->
    <footer>
        &copy; 2025 - João Auto Peças | Desenvolvido por <strong>AssistantHub</strong>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
