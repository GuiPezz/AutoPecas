@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Ícones Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

    <style>
        :root {
            --azul: #003366;
            --vermelho: #dc3545;
            --amarelo: #ffcc00;
            --cinza-claro: #f8f9fa;
        }

        body {
            background-color: var(--cinza-claro);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* 🔹 Navbar superior */
        .navbar-top {
            background-color: #fff;
            border-bottom: 1px solid #ddd;
            padding: 8px 0;
        }

            .navbar-top input::placeholder {
                color: #888;
                font-style: italic;
            }

        /* 🔹 Navbar principal */
        .navbar-main {
            background-color: var(--azul);
        }

        .navbar-brand {
            color: white !important;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

            .navbar-brand span {
                color: var(--amarelo);
            }

        .nav-link {
            color: white !important;
            font-weight: 500;
        }

            .nav-link:hover {
                color: var(--amarelo) !important;
            }

        /* 🔹 Rodapé */
        footer {
            background-color: var(--azul);
            color: white;
            padding: 10px;
            text-align: center;
            margin-top: 50px;
        }

        .cart-badge {
            position: absolute;
            top: 0;
            right: 0;
            transform: translate(50%, -50%);
            background-color: var(--vermelho);
            color: #fff;
            border-radius: 50%;
            font-size: 0.7rem;
            padding: 3px 6px;
        }
    </style>
</head>
<body>

    <!-- 🔹 Barra de busca e conta -->
    <nav class="navbar navbar-top">
        <div class="container d-flex align-items-center justify-content-between">

            <!-- Campo de busca -->
            <form class="d-flex w-50" asp-controller="Produtos" asp-action="Index" method="get">
                <input name="searchString" class="form-control me-2" type="search"
                       placeholder="Digite aqui o que procura" aria-label="Pesquisar" />
                <button class="btn btn-outline-primary" type="submit">
                    <i class="bi bi-search"></i>
                </button>
            </form>

            <!-- Conta e pedidos -->
            <div class="text-end me-4">
                <small class="text-muted">
                    <span class="fw-semibold text-primary">Olá, Guilherme</span><br />
                    <a href="#" class="text-danger fw-bold text-decoration-none">Minha Conta</a>
                    <span class="text-muted mx-1">ou</span>
                    <a href="#" class="text-danger text-decoration-none fw-semibold">Pedidos</a>
                </small>
            </div>

            <!-- Carrinho -->
            <div class="position-relative">
                <a href="#" class="btn btn-primary rounded-circle p-3 position-relative">
                    <i class="bi bi-cart" style="font-size: 1.2rem;"></i>
                    <span class="cart-badge">0</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- 🔹 Navbar principal -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-main">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    João <span>Auto Peças</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Início</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Produtos" asp-action="Index">Produtos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Categorias" asp-action="Index">Categorias</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Clientes" asp-action="Index">Clientes</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacidade</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- 🔹 Conteúdo -->
    <main role="main" class="container mt-4">
        @RenderBody()
    </main>

    <!-- 🔹 Rodapé -->
    <footer>
        &copy; 2025 - João Auto Peças | Desenvolvido por AssistantHub
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
