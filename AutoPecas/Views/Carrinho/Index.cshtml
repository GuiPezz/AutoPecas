@model IEnumerable<AutoPecas.Models.CarrinhoItem>
@{
    ViewData["Title"] = "Carrinho de Compras";
}

<h2 class="mb-4 text-center">🛒 Carrinho de Compras</h2>

@if (!Model.Any())
{
    <p class="text-center text-muted">Seu carrinho está vazio.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Produto</th>
                <th>Preço Unitário</th>
                <th>Quantidade</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Produto.Nome</td>
                    <td>@item.PrecoUnitario.ToString("C")</td>
                    <td>@item.Quantidade</td>
                    <td>@item.Subtotal.ToString("C")</td>
                    <td>
                        <a asp-action="Remover" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                            Remover
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end mt-3">
        <a asp-action="Finalizar" class="btn btn-success btn-lg">
            Finalizar Compra
        </a>
    </div>
}
