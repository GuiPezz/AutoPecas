@model IEnumerable<AutoPecas.Models.Categoria>

<h2>Lista de Categorias</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Nova Categoria</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nome</td>
            </tr>
        }
    </tbody>
</table>
