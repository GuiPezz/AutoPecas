@model AutoPecas.Models.Produto

@{
    ViewData["Title"] = "Cadastrar Produto";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="Nome"></label>
        <input asp-for="Nome" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Preco"></label>
        <input asp-for="Preco" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="CategoriaId">Categoria</label>
        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-control"></select>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Salvar</button>
</form>

<a asp-action="Index">Voltar</a>
