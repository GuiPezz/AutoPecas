@model IEnumerable<AutoPecas.Models.Produto>

@{
    ViewData["Title"] = "Lista de Produtos";
}

<div class="container mt-5">
    <h2 class="fw-bold text-primary mb-4 text-center">🧰 Produtos Cadastrados</h2>

    <div class="d-flex justify-content-end mb-3">
        <a asp-action="Create" class="btn btn-success">+ Novo Produto</a>
    </div>

    <table class="table table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>Preço</th>
                <th>Categoria</th>
                <th>Estoque</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var produto in Model)
            {
                <tr>
                    <td>@produto.Nome</td>
                    <td>R$ @produto.Preco.ToString("N2")</td>
                    <td>@produto.Categoria?.Nome</td>
                    <td>@produto.CategoriaId</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@produto.Id" class="btn btn-warning btn-sm me-2">Editar</a>
                        <a asp-action="Details" asp-route-id="@produto.Id" class="btn btn-info btn-sm me-2 text-white">Detalhes</a>
                        <a asp-action="Delete" asp-route-id="@produto.Id" class="btn btn-danger btn-sm">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center mt-4">
            Nenhum produto cadastrado no momento.
        </div>
    }
</div>

<style>
    h2 {
        color: #003366;
    }

    .table {
        border-radius: 10px;
        overflow: hidden;
        background-color: #fff;
    }

    .btn-warning {
        background-color: #ffcc00;
        border: none;
        color: #000;
        font-weight: 500;
    }

    .btn-info {
        background-color: #00bfff;
        border: none;
    }

    .btn-danger {
        background-color: #dc3545;
        border: none;
    }

    .btn-success {
        background-color: #198754;
        border: none;
    }

    .btn:hover {
        opacity: 0.85;
    }
</style>
