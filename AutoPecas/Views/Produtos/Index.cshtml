@model IEnumerable<AutoPecas.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<h2 class="text-center mb-4">Lista de Produtos</h2>

<div class="container">
    <!-- Botão para criar novo produto -->
    <div class="d-flex justify-content-end mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Novo Produto
        </a>
    </div>

    <table class="table table-striped table-hover shadow-sm align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>Nome</th>
                <th>Preço (R$)</th>
                <th>Categoria</th>
                <th>Estoque</th>
                <th style="width: 200px;">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr class="text-center">
                        <td>@item.Nome</td>
                        <td>@item.Preco.ToString("C")</td>
                        <td>@item.Categoria?.Nome</td>
                        <td>@item.QuantidadeEstoque</td>
                        <td>
                            <div class="btn-group d-flex justify-content-center" role="group">

                                <!-- Editar -->
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <!-- Detalhes -->
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" title="Ver detalhes">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <!-- Deletar -->
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Excluir">
                                    <i class="bi bi-trash"></i>
                                </a>

                                <!-- Comprar (novo botão) -->
                                <a asp-controller="Carrinho" asp-action="Adicionar" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-success" title="Adicionar ao carrinho">
                                    <i class="bi bi-cart-plus"></i> Comprar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Nenhum produto cadastrado.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
