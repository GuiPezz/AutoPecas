@model AutoPecas.Models.Produto

@{
    ViewData["Title"] = "Editar Produto";
}

<h2 class="text-center mb-4">Editar Produto</h2>

<div class="container">
    <div class="card shadow p-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="Nome" class="form-label fw-bold">Nome do Produto</label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Preco" class="form-label fw-bold">Preço (R$)</label>
                <input asp-for="Preco" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CategoriaId" class="form-label fw-bold">Categoria</label>
                <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-select"></select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="QuantidadeEstoque" class="form-label fw-bold">Quantidade em Estoque</label>
                <input asp-for="QuantidadeEstoque" class="form-control" type="number" />
                <span asp-validation-for="QuantidadeEstoque" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="EstoqueMinimo" class="form-label fw-bold">Estoque Mínimo</label>
                <input asp-for="EstoqueMinimo" class="form-control" type="number" />
                <span asp-validation-for="EstoqueMinimo" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                <input type="submit" value="Salvar Alterações" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
